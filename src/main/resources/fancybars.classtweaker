classTweaker v2 official

# Outlined bar text (ported from Skyblocker)
extendable	class	net/minecraft/client/renderer/state/gui/GuiTextRenderState
accessible	field	net/minecraft/client/renderer/state/gui/GuiTextRenderState	font	Lnet/minecraft/client/gui/Font;
accessible	field	net/minecraft/client/renderer/state/gui/GuiTextRenderState	text	Lnet/minecraft/util/FormattedCharSequence;
accessible	field	net/minecraft/client/renderer/state/gui/GuiTextRenderState	x	I
accessible	field	net/minecraft/client/renderer/state/gui/GuiTextRenderState	y	I
accessible	field	net/minecraft/client/renderer/state/gui/GuiTextRenderState	color	I
accessible	field	net/minecraft/client/renderer/state/gui/GuiTextRenderState	backgroundColor	I
accessible	field	net/minecraft/client/renderer/state/gui/GuiTextRenderState	dropShadow	Z
accessible	field	net/minecraft/client/renderer/state/gui/GuiTextRenderState	includeEmpty	Z
accessible	class	net/minecraft/client/gui/Font$PreparedTextBuilder
accessible	field	net/minecraft/client/gui/Font$PreparedTextBuilder	x	F
accessible	field	net/minecraft/client/gui/Font$PreparedTextBuilder	y	F

# Chroma text for maxed enchants (same as SkyHanni)
accessible	class	net/minecraft/client/gui/font/glyphs/BakedSheetGlyph$GlyphInstance

# Storage Overlay moves the real slots into its panel (same as Skysoft)
mutable	field	net/minecraft/world/inventory/Slot	x	I
mutable	field	net/minecraft/world/inventory/Slot	y	I
